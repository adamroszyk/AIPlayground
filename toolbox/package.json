{
  "name": "toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "High-search-intent utility tools: web landing pages + one MCP server for ChatGPT, Claude and Grok.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build:widget": "node scripts/build-widget.ts",
    "build:site": "node site/build.ts",
    "build": "npm run build:widget && npm run build:site",
    "start": "npm run build:widget && node src/server/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.2.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
