[
  {
    "name": "plan_room_layout",
    "title": "Plan a room layout",
    "description": "Use this when the user wants to plan, arrange or rearrange furniture in a room for a home redesign, remodel or decorating project, or to see whether a set of furniture will fit. Plans where furniture goes in one room, to scale, from the room's size, door and window positions, and a list of furniture with sizes, then checks the layout against clearance rules: walkway width, door swings, sofa-to-coffee-table distance, dining and storage clearance, and whether every seat can be reached. Returns each piece's position and facing, a pass/fail report with measured values, and links to view and edit the plan on the web. Do not use to redesign a room from a photo, choose styles, colours or decor, order furniture, or give structural or building-code advice.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "unit": {
          "default": "in",
          "description": "Unit used for every length in this call (room, openings, furniture, positions). Default inches.",
          "type": "string",
          "enum": [
            "in",
            "ft",
            "cm",
            "m"
          ]
        },
        "room": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "West-to-east length of the room."
            },
            "length": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "North-to-south length of the room."
            },
            "doors": {
              "description": "Doors. At least one is strongly recommended so walkways can be checked.",
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "wall": {
                    "type": "string",
                    "enum": [
                      "north",
                      "east",
                      "south",
                      "west"
                    ],
                    "description": "Which wall the opening is on. North is the top wall of the plan, south the bottom, west the left, east the right."
                  },
                  "offset": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Distance from the corner to the nearest edge of the opening: from the west end of a north or south wall, or from the north end of an east or west wall."
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Width of the opening."
                  },
                  "height": {
                    "description": "Height of the opening; only used for paint estimates. Defaults to 80 in for doors and 48 in for windows.",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "swing": {
                    "description": "Doors only: whether the door swings into the room (default) or outward.",
                    "type": "string",
                    "enum": [
                      "in",
                      "out"
                    ]
                  }
                },
                "required": [
                  "wall",
                  "offset",
                  "width"
                ]
              }
            },
            "windows": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "wall": {
                    "type": "string",
                    "enum": [
                      "north",
                      "east",
                      "south",
                      "west"
                    ],
                    "description": "Which wall the opening is on. North is the top wall of the plan, south the bottom, west the left, east the right."
                  },
                  "offset": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Distance from the corner to the nearest edge of the opening: from the west end of a north or south wall, or from the north end of an east or west wall."
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Width of the opening."
                  },
                  "height": {
                    "description": "Height of the opening; only used for paint estimates. Defaults to 80 in for doors and 48 in for windows.",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "swing": {
                    "description": "Doors only: whether the door swings into the room (default) or outward.",
                    "type": "string",
                    "enum": [
                      "in",
                      "out"
                    ]
                  }
                },
                "required": [
                  "wall",
                  "offset",
                  "width"
                ]
              }
            }
          },
          "required": [
            "width",
            "length"
          ]
        },
        "furniture": {
          "minItems": 1,
          "maxItems": 25,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Name shown on the plan, e.g. 'Sofa'."
              },
              "kind": {
                "description": "Type of furniture; it decides which clearance rules apply. Use 'generic' if none fit.",
                "type": "string",
                "enum": [
                  "sofa",
                  "chair",
                  "coffee_table",
                  "side_table",
                  "tv",
                  "bed",
                  "nightstand",
                  "desk",
                  "dining_table",
                  "storage",
                  "generic"
                ]
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Side-to-side size of the piece as you face its front."
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Front-to-back size of the piece."
              },
              "tall": {
                "description": "True for pieces that must not cover a window, such as a bookcase.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "width",
              "depth"
            ]
          }
        },
        "save": {
          "default": true,
          "description": "Save the plan and return links to view and edit it. Set false for a throwaway check.",
          "type": "boolean"
        }
      },
      "required": [
        "room",
        "furniture"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "title": "Plan a room layout"
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://roomwise/plan.html"
      },
      "ui/resourceUri": "ui://roomwise/plan.html"
    }
  },
