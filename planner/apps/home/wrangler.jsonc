{
  "name": "roomwise",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.well-known/*", "/mcp", "/p/*"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [{ "binding": "WAITLIST" }],
  "d1_databases": [{ "binding": "DB", "database_name": "roomwise", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 3 * * *"] }
}
