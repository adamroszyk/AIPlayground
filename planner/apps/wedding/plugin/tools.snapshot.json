  {
    "name": "build_wedding_timeline",
    "title": "Build a wedding day timeline",
    "description": "Builds a day-of schedule from the ceremony start time: guest arrival, ceremony, photos, optional travel between venues, cocktail hour, dinner, toasts, first dance, cake and dancing, with buffers between segments. Warns if it runs past a venue curfew or if photos run after sunset. Times are 24-hour HH:MM. Use when the user wants a wedding day schedule. Durations are in minutes and all optional.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "ceremonyStart": {
          "type": "string",
          "description": "Ceremony start, 24-hour HH:MM, e.g. 16:00."
        },
        "ceremonyMinutes": {
          "description": "Ceremony length in minutes (default 30).",
          "type": "number",
          "minimum": 0,
          "maximum": 240
        },
        "guestsArriveMinutesBefore": {
          "description": "How long before the ceremony guests start arriving (default 30).",
          "type": "number",
          "minimum": 0,
          "maximum": 240
        },
        "photosMinutes": {
          "description": "Photo session after the ceremony, in minutes (default 45).",
          "type": "number",
          "minimum": 0,
          "maximum": 240
        },
        "travelMinutes": {
          "description": "Travel between ceremony and reception venues; 0 if the same place.",
          "type": "number",
          "minimum": 0,
          "maximum": 240
        },
        "cocktailMinutes": {
          "description": "Cocktail hour length in minutes (default 60).",
          "type": "number",
          "minimum": 0,
          "maximum": 240
        },
        "dinnerMinutes": {
          "description": "Dinner length in minutes (default 75).",
          "type": "number",
          "minimum": 0,
          "maximum": 240
        },
        "toastsMinutes": {
          "description": "Speeches and toasts in minutes (default 20).",
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "firstDanceMinutes": {
          "description": "First dance in minutes (default 10).",
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "cakeMinutes": {
          "description": "Cake cutting in minutes (default 15).",
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "danceMinutes": {
          "description": "Open dancing in minutes (default 120).",
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "bufferMinutes": {
          "description": "Slack between segments in minutes (default 10).",
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "venueCurfew": {
          "description": "Time the venue must be empty, HH:MM. Earlier than the ceremony means after midnight.",
          "type": "string"
        },
        "sunset": {
          "description": "Sunset time HH:MM, to flag outdoor photos after dark.",
          "type": "string"
        }
      },
      "required": [
        "ceremonyStart"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "title": "Build a wedding day timeline"
    }
  }
]
