                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "apart"
                  },
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "a",
                  "b"
                ],
                "description": "These two guests must not share a table."
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "head_table"
                  },
                  "guests": {
                    "minItems": 1,
                    "maxItems": 24,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
