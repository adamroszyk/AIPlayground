                  },
                  "guest": {
                    "type": "string"
                  },
                  "table": {
                    "type": "string",
                    "description": "The table's name, e.g. 'Table 3'."
                  }
                },
                "required": [
                  "type",
                  "guest",
                  "table"
                ],
                "description": "This guest must sit at this table."
              }
            ]
          }
        },
        "arrangement": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "description": "Table name, e.g. 'Table 2'."
              },
              "guests": {
                "type": "array",
