{
  "name": "aisle",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.well-known/*", "/mcp"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [{ "binding": "WAITLIST" }]
}
